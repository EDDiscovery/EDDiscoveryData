ACTIONFILE V4

ENABLED True

INSTALL LongDescription="This is the 3rd edition of the Joystick,Keyboard, Mouse pack for EDD, for version 20+\r\n\r\nIt vocalises events caused by joystick, key and mouse bindings."
INSTALL ShortDescription="JKM Pack for ED"
INSTALL Version=3.1.0.0
INSTALL MinEDVersion=20.0.0.0
INSTALL Location=Actions
INSTALL DisableOther1=JKMV1
INSTALL DisableOther2=JKMV2

EVENT onStartup, onStartup, "", Condition AlwaysTrue
EVENT onPostStartup, onPostStartup, "", Condition AlwaysTrue
EVENT onInstall, onInstall, "", Condition AlwaysTrue
EVENT onMenuItem, Menus, "", MenuName Contains jkmMenu
EVENT onEliteInput, TurnOn, "", Condition AlwaysTrue
EVENT onSayFinished, FinishSpeech, "", EventName $== JKMFinish
EVENT onEliteInputRaw, RawInput, "", Condition AlwaysTrue
EVENT UIOverallStatus, OverallStatus, "", Condition AlwaysTrue

//*************************************************************
// SetUpLanguageEnglish
// Events: None
//*************************************************************
PROGRAM SetUpLanguageEnglish

Static jkm_install $= You have installed Elite Dangerous Discovery, Joystick, Keyboard, Mouse Pack 2, English version

Rem jkm_mode_binding
Rem prefixes are LandingGear, NormalSpace, Docked, Supercruise_0 (no SCO), Supercruise_1 (SCO), Landed, SRV, Fighter, OnFoot (checked first)
Rem then Vehicle prefix is checked if prefix was NormalSpace,SRV,Supercruise
Rem then Ship prefix is checked if prefix was NormalSpace,Supercruise
Rem also All prefix is checked as a last check

Static jkm_powerbindings $= IncreaseEnginesPower_Buggy,IncreaseSystemsPower_Buggy,IncreaseWeaponsPower_Buggy,ResetPowerDistribution_Buggy,IncreaseEnginesPower,IncreaseWeaponsPower,IncreaseSystemsPower,ResetPowerDistribution
Static jkm_Vehicle_Power = Adjusting power;Changing power allocation

// normal supercruise (then vehicle then ship then all is checked)

Static jkm_Supercruise_0_TargetNextRouteSystem $= Selected existing route
Static jkm_Supercruise_0_OrbitLinesToggle $= Toggle orbit lines
Static jkm_Supercruise_0_EngineColourToggle $= Toggling engine colour
Static jkm_Supercruise_0_UseBoostJuice $= Overdrive on;Overdrive, Hold onto your hat Commander;Overdrive Activated
Static jkm_Supercruise_0_WingNavLock $= Toggle wing man navigational lock

//  SCO supercruise (no others are checked)

Static jkm_Supercruise_1_UseBoostJuice $= Overdrive off;Normal Supercruise Commander
Static jkm_Supercruise_1_FocusLeftPanel $= Toggling target panel; Target Panel toggle; Target Panel
Static jkm_Supercruise_1_SelectTarget $= Selecting target

// Normal space (then vehicle then ship then all is checked)

Static jkm_NormalSpace_CycleNextSubsystem $= Next target subsystem
Static jkm_NormalSpace_CyclePreviousSubsystem $= Previous target subsystem
Static jkm_NormalSpace_UseBoostJuice $= Boosting;Boost Juice;Boost On

Static jkm_NormalSpace_UseShieldCell $= Discharging Shield Cell
Static jkm_NormalSpace_DeployHeatSink $= Fire heatsink
Static jkm_NormalSpace_FireChaffLauncher $= Fire chaff
Static jkm_NormalSpace_ChargeECM $= Charging ECM

Static jkm_NormalSpace_OrderRequestDock $= Request Fighter dock; Fighter request docking
Static jkm_NormalSpace_OrderDefensiveBehaviour $= Defensive mode; defensive mode
Static jkm_NormalSpace_OrderAggressiveBehaviour $= Agressive mode; Attack Now
Static jkm_NormalSpace_OrderFocusTarget $= Attack selected target; Attack selected target
Static jkm_NormalSpace_OrderHoldFire $= Hold fire; Stop firing; Desist attack
Static jkm_NormalSpace_OrderHoldPosition $= Hold position; Hold position and cease attack
Static jkm_NormalSpace_OrderFollow $= Follow me; Follow my direction
Static jkm_NormalSpace_OpenOrders $= Open orders

Static jkm_NormalSpace_CycleNextHostileTarget $= Next Hostile
Static jkm_NormalSpace_CyclePreviousHostileTarget $= Previous Hostile
Static jkm_NormalSpace_SelectHighestThreat $= Highest Threat

Static jkm_NormalSpace_SelectTargetsTarget $= Select wing man target;Selected target of current wingman

// checked after Supercruise_0, NormalSpace, SRV.  

Static jkm_Vehicle_SetSpeedMinus100 $= Full astern
Static jkm_Vehicle_SetSpeedMinus75 $= 75 percent astern
Static jkm_Vehicle_SetSpeedMinus50 $= 50 percent astern
Static jkm_Vehicle_SetSpeedMinus25 $= 25 percent astern
Static jkm_Vehicle_SetSpeedZero $= Engines off
Static jkm_Vehicle_SetSpeed25 $= 25 percent ahead;Quarter speed captain
Static jkm_Vehicle_SetSpeed50 $= 50 percent ahead;Half ahead captain
Static jkm_Vehicle_SetSpeed75 $= 75 percent ahead;Three quarters Ahead captain
Static jkm_Vehicle_SetSpeed100 $= Full ahead;Full speed

Static jkm_Vehicle_FocusLeftPanel $= Toggling target panel; Target Panel toggle; Target Panel
Static jkm_Vehicle_FocusRightPanel $= Toggling system panel; System Panel toggle; System Panel
Static jkm_Vehicle_FocusRadarPanel $= Toggling role panel; Role Panel toggle; Role Panel
Static jkm_Vehicle_QuickCommsPanel $= Quick Communication panel; Quick Communication;Quick Comms
Static jkm_Vehicle_FocusCommsPanel $= Communication panel; Toggle Communication Panel; Comms
Static jkm_Vehicle_FriendsMenu $= Toggle Friend menu
Static jkm_Vehicle_HeadLookToggle $= Toggle head look

Static jkm_Vehicle_SelectTarget $= Selecting target
Static jkm_Vehicle_CycleNextTarget $= Next target
Static jkm_Vehicle_CyclePreviousTarget $= Previous target

// checked after Vehicle failed for Normalspace/Supercruise_0

Static jkm_Ship_TargetWingman0 $= Select wing man 1;Wing man 1 targetted
Static jkm_Ship_TargetWingman1 $= Select wing man 2;Wing man 2 targetted
Static jkm_Ship_TargetWingman2 $= Select wing man 3;Wing man 3 targetted
Static jkm_Ship_WeaponColourToggle $= Toggline weapons colour

// Final all

Static jkm_All_GalaxyMapOpen $= Toggle galaxy map
Static jkm_All_SystemMapOpen $= Toggle system map
Static jkm_All_MicrophoneMute $= Toggling microphone mute
Static jkm_All_PhotoCameraToggle $= Toggle camera mode
Static jkm_All_UIFocus $= Toggle panel

// other setups

Static jkmSpeechCulture = en-gb

END PROGRAM

//*************************************************************
// SetUpLanguage
// Events: None
//*************************************************************
PROGRAM SetUpLanguage

Rem do these.. If %(CurrentCulture) Contains sv
Call SetUpLanguageEnglish

Static Guimode = 0

END PROGRAM

//*************************************************************
// onStartup
// Events: onStartup
//*************************************************************
PROGRAM onStartup

Print JKM Pack installed, running on EDD Version %version(1).%version(2).%version(3).%version(4)

Call SetUpLanguage
Call Initialise

END PROGRAM

//*************************************************************
// onPostStartup
// Events: onPostStartup
//*************************************************************
PROGRAM onPostStartup

MenuItem VoiceMenuConfigureVoice                                // see of voice menu installed..
If MenuPresent IsFalse
    MenuItem jkmMenuVoice,add-ons,"Voice Synthesis Configuration",speaker

END PROGRAM

//*************************************************************
// onInstall
// Events: onInstall
//*************************************************************
PROGRAM onInstall

If InstallList Contains JKMV
    Call SetUpLanguage
    Call Initialise
    Say %(jkm_install)
    MenuItem jkmMenuVoice,add-ons,"Voice Synthesis Configuration",speaker

END PROGRAM

//*************************************************************
// Initialise
// Events: None
//*************************************************************
PROGRAM Initialise

Perform EnableEliteInputNoAxis
Static jkm_lastbinding = None
Static jkm_lastbindingtime = 0
Static jkm_speaking = 0

static jkm_repeat_time = 3000              // don't say same event more often
static jkm_speechqueuelimit = 3000

static majormode = none
static fullmode = none
Static GUIFocus = 0
Static LandingGear = 0
Static CameraMode = 0
Static CargoDeployed = 0
Static Overdrive = 0

Perform listeliteinput
Print %(EliteInputCheck)

END PROGRAM

//*************************************************************
// Menus
// Events: onMenuItem?(MenuName Contains jkmMenu)
//*************************************************************
PROGRAM Menus

If MenuName Contains jkmMenuVoice
    Perform ConfigureVoice "Configure Voice Synthesis"

END PROGRAM

