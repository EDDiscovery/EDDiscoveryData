// RawInput
//*************************************************************

PROGRAM RawInput

if Pressed IsTrue
    rem print Raw Input %(Device) %(EventName) %(Pressed) %(Value)
    rem pragma dumplocalvars *
    rem print -----
END PROGRAM

//*************************************************************
// RawInput
//*************************************************************

PROGRAM OverallStatus

static majormode = %(EventClass_UIMode_MajorMode)
static fullmode = %(EventClass_UIMode_Mode)
Static GUIFocus = %(Status_GUIFocus)
Static LandingGear = %(Status_LandingGear)
Static CargoDeployed = %(Status_CargoScoopDeployed)
Static Overdrive = %(Status_SupercruiseOverdrive)

rem pragma dumplocalvars Status_*

rem print Major %(majormode) Minor %(fullmode) : gui %(GUIFocus) lg %(LandingGear)

END PROGRAM

//*************************************************************
// TurnOn
// Events: onEliteInput
//*************************************************************
PROGRAM TurnOn

if Device $!= "Mouse"
    rem pragma dumplocalvars *

rem Print Run
rem print
rem Print %(Device), `%(Binding)`, List: %(BindingList), EventName:%(EventName) Pressed:%(Pressed) Value:%(Value)
rem Print JMK Hit: %(Device), %(Binding), %(majormode), %(fullmode), GUI Focus Checked %(GUIFocus) Landing Gear %(LandingGear)

If Binding $== PhotoCameraToggle
    StaticLet CameraMode = !%(CameraMode)
    Print Camera mode is %(CameraMode)

If %(CameraMode) == 1 And Binding $!= PhotoCameraToggle         // No GUI focus from those frontier people so have to do something nasty
    Set Binding = PhotoCamera

If Binding IsOneOf %(jkm_powerbindings)                         // if power binding, alter to generic name
    Set Binding = Power

// can't do these..

rem print nofocus

If GUIFocus $== NoFocus                                         // must be active and not in a sub window
    Rem UI fullmode contains  MainShipNormalSpace,MainShipDockedStarPort,MainShipDockedPlanet,MainShipSupercruise,MainShipLanded,SRV,Fighter,
    Rem OnFootStarPortHangar,OnFootStarPortSocialSpace,OnFootPlantaryPortHangar,OnFootPlantaryPortSocialSpace,OnFootInstallationInside,OnFootPlanet
    
    rem results in these prefix's. 

    If fullmode Contains Docked                                   // remove all taxi/multicrew stuff. Fighter is passed thru
        Set prefix = "Docked"
    Else If fullmode Contains Landed
        Set prefix = "Landed"
    else If LandingGear IsTrue
        Set prefix = "LandingGear"
    Else If fullmode Contains NormalSpace
        Set prefix = "NormalSpace"
    Else If fullmode Contains Supercruise
        Set prefix = "Supercruise_%(Overdrive)"                     // supercruise_0 is normal, _1 is SCO
    Else If fullmode Contains SRV
        Set prefix = "SRV"
    Else If fullmode Contains OnFoot
        Set prefix = "OnFoot"
    Else If fullmode Contains Fighter
        Set prefix = "Fighter"
    Else
        print Failed to find operational mode - fail JMK

    Set v = jkm_%(prefix)_%(Binding)                            // make up variable name from the state and event name

    rem print First Prefix %(prefix) : Lookup %(v) 

    if Binding $== "UseBoostJuice" 
        If CargoDeployed IsTrue
            end
        If prefix $== "Supercruise_0"
            Ship Current                                        // get current ship (new 20.0 ed)
            if %FindInArray(SH_Ship_Module,"_Item","(SCO)",0,10000,"contains") == -1        // find any item with SCO in it, if not, no SCO, no boost
                rem print no sco Prefix %(prefix) : Lookup %(v) 
                end

    If %(v) NotPresent
        If prefix $== NormalSpace Or prefix $== Supercruise_0 Or prefix $== SRV    // if vehicle
            Set v = jkm_Vehicle_%(Binding)                      // make up variable name from the state and event name
            rem print Next1 Lookup %(v)

    If %(v) NotPresent
        If prefix $== NormalSpace Or prefix $== Supercruise_0
            Set v = jkm_Ship_%(Binding)                         // make up variable name from the state and event name
            rem print Next2 Lookup %(v)

    If %(v) NotPresent
        Set v = jkm_All_%(Binding)                              // make up variable name from the state and event name
        rem print Next3 Lookup %(v)

    If %(v) IsPresent And %(v) IsNotEmpty                       // we have a binding
        rem print BINGO on %(v)
        If Binding $!= %(jkm_lastbinding) Or "%eval(\"%TickCount()-%(jkm_lastbindingtime)\")" > %(jkm_repeat_time)
            Set speech = "%phrase(\"%indirect(v)\")"            // now expand any phrases in it
            Call speak(speech="%(speech)",Priority="Normal")
            // print Say %(speech)  %TickCount() %(jkm_lastbindingtime)
            Static jkm_lastbinding = %(Binding)
            Static jkm_lastbindingtime = %TickCount()
        Else 
            Static jkm_lastbindingtime = %TickCount()
            // Print rejected due to duplicate binding in less than X second %TickCount() %(jkm_lastbindingtime)

END PROGRAM

//*************************************************************
// speak
// Events: None
//*************************************************************
PROGRAM speak

Rem speech always, optional: Volume, Priority, FinishEvent, Wait

Set speech = "%replacevar(speech,\"jkm_tx\")"

Set ds = 0
If SpeechOptions IsPresent And SpeechOptions Contains PrintOnly;
    Set ds = 1

// Real time with queue limit

rem print Would say %(speech)
Say %(speech), QueueLimit=%(jkm_speechqueuelimit), Literal=1, Volume="%existsdefault(Volume,\"-999\")", Priority="%existsdefault(Priority,\"Normal\")", DontSpeak="%(ds)", FinishEvent="JKMFinish" , Wait="%existsdefault(Wait,\"0\")"

Static jkm_speaking = 1

Rem Print JKM Say %(speech)

If SpeechLog IsPresent And SpeechLog IsNotEmpty
    If SpeechOptions IsPresent And SpeechOptions Contains LogLastOnly;
        Let success = %openfile(h1,SpeechLog,create)
    Else 
        Let success = %openfile(h1,SpeechLog,append)

    If success IsTrue
        If SpeechOptions IsPresent And SpeechOptions Contains LogTimeDate;
            Expr %write(h1,"%datetimenow(tolocal):")

        Expr %writeline(h1,speech)
        Expr %closefile(h1)
    Else 
        Print Cannot write to speech log file '%(SpeechLog)'

END PROGRAM

//*************************************************************
// FinishSpeech
// Events: onSayFinished?(EventName $== JKMFinish)
//*************************************************************
PROGRAM FinishSpeech

// Holding this for later work
Static jkm_speaking = 0

END PROGRAM

