ACTIONFILE V4

ENABLED True

INSTALL LongDescription="This is the standard keyboard pack for ED Discovery, Version 7.\r\nIt adds control key functions to control the pop ups and the three configurable views on the travel page\r\n\r\nIt adds new function key mappings as well.\r\nSee the EDDiscovery help for keyboard mappings\r\nEnjoy!\r\n"
INSTALL ShortDescription="Key Definition file"
INSTALL Version=7.0.0.0
INSTALL MinEDVersion=20.0.0.0
INSTALL Location=Actions
INSTALL DisableOther1=KeyPressesV1
INSTALL DisableOther2=KeyPressesV2
INSTALL DisableOther3=KeyPressesV3
INSTALL DisableOther4=KeyPressesV4
INSTALL DisableOther5=KeyPressesV5
INSTALL DisableOther6=KeyPressesV6


GROUP Main Window

EVENT onKeyPress, ProgramWindow, cmd=topmost, KeyPress $== Alt+F1
EVENT onKeyPress, ProgramWindow, cmd=normalz, KeyPress $== Alt+F2
EVENT onKeyPress, ProgramWindow, cmd=showintaskbar, KeyPress $== Alt+F3
EVENT onKeyPress, ProgramWindow, cmd=notshowintaskbar, KeyPress $== Alt+F4

GROUP Tabs

EVENT onKeyPress, ProgramWindow, "cmd=\"tab history\"", KeyPress $== Ctrl+1
EVENT onKeyPress, ProgramWindow, "cmd=\"opentab JournalHistory\"", KeyPress $== Ctrl+2
EVENT onKeyPress, ProgramWindow, "cmd=\"opentab expedition\"", KeyPress $== Ctrl+3
EVENT onKeyPress, ProgramWindow, "cmd=\"opentab screenshot\"", KeyPress $== Ctrl+4
EVENT onKeyPress, ProgramWindow, "cmd=\"opentab RouteFinder\"", KeyPress $== Ctrl+5
EVENT onKeyPress, ProgramWindow, "cmd=\"opentab Bookmarks\"", KeyPress $== Ctrl+6
EVENT onKeyPress, ProgramWindow, "cmd=\"opentab Ledger\"", KeyPress $== Ctrl+7
EVENT onKeyPress, ProgramWindow, "cmd=\"opentab SettingsPanel\"", KeyPress $== Ctrl+8

GROUP Panels

EVENT onKeyPress, TogglePanel, panel=bottom, KeyPress $== Ctrl+Comma
EVENT onKeyPress, TogglePanel, panel=bottom-right, KeyPress $== Ctrl+Period
EVENT onKeyPress, TogglePanel, panel=middle-right, KeyPress $== Ctrl+Question
EVENT onKeyPress, TogglePanel, panel=top-right, KeyPress $== Ctrl+Quotes

GROUP PopOuts

EVENT onKeyPress, TogglePopout, panel=journalhistory, KeyPress $== Ctrl+J
EVENT onKeyPress, ToggleMinimise, panel=journalhistory, KeyPress $== Shift+Ctrl+J
EVENT onKeyPress, TogglePopout, panel=expedition, KeyPress $== Ctrl+E
EVENT onKeyPress, ToggleMinimise, panel=expedition, KeyPress $== Shift+Ctrl+E
EVENT onKeyPress, TogglePopout, panel=screenshot, KeyPress $== Ctrl+I
EVENT onKeyPress, ToggleMinimise, panel=screenshot, KeyPress $== Shift+Ctrl+I
EVENT onKeyPress, TogglePopout, panel=routefinder, KeyPress $== Ctrl+T
EVENT onKeyPress, ToggleMinimise, panel=routefinder, KeyPress $== Shift+Ctrl+T
EVENT onKeyPress, TogglePopout, panel=bookmarks, KeyPress $== Ctrl+B
EVENT onKeyPress, ToggleMinimise, panel=bookmarks, KeyPress $== Shift+Ctrl+B
EVENT onKeyPress, TogglePopout, panel=ledger, KeyPress $== Ctrl+G
EVENT onKeyPress, ToggleMinimise, panel=ledger, KeyPress $== Shift+Ctrl+G
EVENT onKeyPress, TogglePopout, panel=map3d, KeyPress $== Ctrl+N
EVENT onKeyPress, ToggleMinimise, panel=map3d, KeyPress $== Shift+Ctrl+N
EVENT onKeyPress, TogglePopout, panel=stardistance, KeyPress $== Ctrl+D
EVENT onKeyPress, ToggleMinimise, panel=stardistance, KeyPress $== Shift+Ctrl+D
EVENT onKeyPress, TogglePopout, panel=travelhistory, KeyPress $== Ctrl+H
EVENT onKeyPress, ToggleMinimise, panel=travelhistory, KeyPress $== Shift+Ctrl+H
EVENT onKeyPress, TogglePopout, panel=log, KeyPress $== Ctrl+L
EVENT onKeyPress, ToggleMinimise, panel=log, KeyPress $== Shift+Ctrl+L
EVENT onKeyPress, TogglePopout, panel=materials, KeyPress $== Ctrl+M
EVENT onKeyPress, ToggleMinimise, panel=materials, KeyPress $== Shift+Ctrl+M
EVENT onKeyPress, TogglePopout, panel=commodities, KeyPress $== Ctrl+O
EVENT onKeyPress, ToggleMinimise, panel=commodities, KeyPress $== Shift+Ctrl+O
EVENT onKeyPress, TogglePopout, panel=scan, KeyPress $== Ctrl+P
EVENT onKeyPress, ToggleMinimise, panel=scan, KeyPress $== Shift+Ctrl+P
EVENT onKeyPress, TogglePopout, panel=spanel, KeyPress $== Ctrl+S
EVENT onKeyPress, ToggleMinimise, panel=spanel, KeyPress $== Shift+Ctrl+S
EVENT onKeyPress, TogglePopout, panel=stats, KeyPress $== Ctrl+Q
EVENT onKeyPress, ToggleMinimise, panel=stats, KeyPress $== Shift+Ctrl+Q
EVENT onKeyPress, TogglePopout, panel=routetracker, KeyPress $== Ctrl+R
EVENT onKeyPress, ToggleMinimise, panel=routetracker, KeyPress $== Shift+Ctrl+R

GROUP Misc

EVENT onKeyPress, Perform, Perform=2dmap, KeyPress $== F2
EVENT onKeyPress, Perform, Perform=3dmap, KeyPress $== F3
EVENT onKeyPress, ExecuteEvent, cmd=openjournalineditor, KeyPress $== F4
EVENT onKeyPress, LastAction, "", KeyPress $== F5
EVENT onKeyPress, Mute, "", KeyPress $== F6
EVENT onKeyPress, Perform, Perform=EditLastPack, KeyPress $== F8
EVENT onKeyPress, Perform, Perform=editlasttext, KeyPress $== Shift+F8
EVENT onKeyPress, Perform, Perform=ManageAddOns, KeyPress $== Ctrl+F6
EVENT onKeyPress, Perform, Perform=ConfigureVoice, KeyPress $== Alt+F8
EVENT onKeyPress, Perform, Perform=Refresh, KeyPress $== F12

//*************************************************************
// TogglePopout
// Events: onKeyPress?(KeyPress $== Ctrl+J)(panel=journalhistory), onKeyPress?(KeyPress $== Ctrl+E)(panel=expedition), onKeyPress?(KeyPress $== Ctrl+I)(panel=screenshot)
// Events: onKeyPress?(KeyPress $== Ctrl+T)(panel=routefinder), onKeyPress?(KeyPress $== Ctrl+B)(panel=bookmarks), onKeyPress?(KeyPress $== Ctrl+G)(panel=ledger)
// Events: onKeyPress?(KeyPress $== Ctrl+N)(panel=map3d), onKeyPress?(KeyPress $== Ctrl+D)(panel=stardistance), onKeyPress?(KeyPress $== Ctrl+H)(panel=travelhistory)
// Events: onKeyPress?(KeyPress $== Ctrl+L)(panel=log), onKeyPress?(KeyPress $== Ctrl+M)(panel=materials), onKeyPress?(KeyPress $== Ctrl+O)(panel=commodities)
// Events: onKeyPress?(KeyPress $== Ctrl+P)(panel=scan), onKeyPress?(KeyPress $== Ctrl+S)(panel=spanel), onKeyPress?(KeyPress $== Ctrl+Q)(panel=stats)
// Events: onKeyPress?(KeyPress $== Ctrl+R)(panel=routetracker)
//*************************************************************
PROGRAM TogglePopout

If KeyPanel NotPresent Or KeyPanel $== Complete
    Rem the 1 is the first instance of it in, as done in PopOut(), in the windows ref name field

    Popout %(panel)1 status
    Rem Print Toggle Popout check state of %(panel)1 is %(P_Exists)

    If %(P_Exists) IsTrue
        Rem Print Toggle Popout check state of %(panel)1 is %(P_Exists) %(P_WindowState)

        If %(P_WindowState) $== Minimized
            Popout %(panel)1 normal
        Else 
            Popout %(panel)1 toggle
    Else 
        Popout %(panel) toggle
Else 
    Pragma ignoreerrors
    Historytab %(KeyPanel) %(panel)
    If LastError NotPresent
        Print Switch panel %(panel) to %(KeyPanel)
    Global KeyPanel = Complete

END PROGRAM

//*************************************************************
// ToggleMinimise
// Events: onKeyPress?(KeyPress $== Shift+Ctrl+J)(panel=journalhistory), onKeyPress?(KeyPress $== Shift+Ctrl+E)(panel=expedition)
// Events: onKeyPress?(KeyPress $== Shift+Ctrl+I)(panel=screenshot), onKeyPress?(KeyPress $== Shift+Ctrl+T)(panel=routefinder)
// Events: onKeyPress?(KeyPress $== Shift+Ctrl+B)(panel=bookmarks), onKeyPress?(KeyPress $== Shift+Ctrl+G)(panel=ledger), onKeyPress?(KeyPress $== Shift+Ctrl+N)(panel=map3d)
// Events: onKeyPress?(KeyPress $== Shift+Ctrl+D)(panel=stardistance), onKeyPress?(KeyPress $== Shift+Ctrl+H)(panel=travelhistory)
// Events: onKeyPress?(KeyPress $== Shift+Ctrl+L)(panel=log), onKeyPress?(KeyPress $== Shift+Ctrl+M)(panel=materials), onKeyPress?(KeyPress $== Shift+Ctrl+O)(panel=commodities)
// Events: onKeyPress?(KeyPress $== Shift+Ctrl+P)(panel=scan), onKeyPress?(KeyPress $== Shift+Ctrl+S)(panel=spanel), onKeyPress?(KeyPress $== Shift+Ctrl+Q)(panel=stats)
// Events: onKeyPress?(KeyPress $== Shift+Ctrl+R)(panel=routetracker)
//*************************************************************
PROGRAM ToggleMinimise

Popout %(panel)1 status

If %(P_Exists) IsTrue
    If %(P_WindowState) $== Minimized
        Popout %(panel)1 normal
    Else 
        Popout %(panel)1 minimize

END PROGRAM

//*************************************************************
// TogglePanel
// Events: onKeyPress?(KeyPress $== Ctrl+Comma)(panel=bottom), onKeyPress?(KeyPress $== Ctrl+Period)(panel=bottom-right), onKeyPress?(KeyPress $== Ctrl+Question)(panel=middle-right)
// Events: onKeyPress?(KeyPress $== Ctrl+Quotes)(panel=top-right)
//*************************************************************
PROGRAM TogglePanel

Global KeyPanel = %(panel)
Say "Selecting %(panel)"

END PROGRAM

//*************************************************************
// Perform
// Events: onKeyPress?(KeyPress $== F2)(Perform=2dmap), onKeyPress?(KeyPress $== F3)(Perform=3dmap), onKeyPress?(KeyPress $== F8)(Perform=EditLastPack)
// Events: onKeyPress?(KeyPress $== Shift+F8)(Perform=editlasttext), onKeyPress?(KeyPress $== Ctrl+F6)(Perform=ManageAddOns)
// Events: onKeyPress?(KeyPress $== Alt+F8)(Perform=ConfigureVoice), onKeyPress?(KeyPress $== F12)(Perform=Refresh)
//*************************************************************
PROGRAM Perform

Perform %(Perform)

END PROGRAM

//*************************************************************
// ExecuteEvent
// Events: onKeyPress?(KeyPress $== F4)(cmd=openjournalineditor)
//*************************************************************
PROGRAM ExecuteEvent

Event THPOS
If %(EC_JID) != 0
    Event FROM %(EC_JID) %(cmd)

END PROGRAM

//*************************************************************
// LastAction
// Events: onKeyPress?(KeyPress $== F5)
//*************************************************************
PROGRAM LastAction

Event THPOS
If %(EC_JID) $!= 0
    Event FROM %(EC_JID) ACTION

END PROGRAM

//*************************************************************
// ProgramWindow
// Events: onKeyPress?(KeyPress $== Alt+F1)(cmd=topmost), onKeyPress?(KeyPress $== Alt+F2)(cmd=normalz), onKeyPress?(KeyPress $== Alt+F3)(cmd=showintaskbar)
// Events: onKeyPress?(KeyPress $== Alt+F4)(cmd=notshowintaskbar), onKeyPress?(KeyPress $== Ctrl+1)(cmd="tab history"), onKeyPress?(KeyPress $== Ctrl+2)(cmd="opentab JournalHistory")
// Events: onKeyPress?(KeyPress $== Ctrl+3)(cmd="opentab expedition"), onKeyPress?(KeyPress $== Ctrl+4)(cmd="opentab screenshot")
// Events: onKeyPress?(KeyPress $== Ctrl+5)(cmd="opentab RouteFinder"), onKeyPress?(KeyPress $== Ctrl+6)(cmd="opentab Bookmarks")
// Events: onKeyPress?(KeyPress $== Ctrl+7)(cmd="opentab Ledger"), onKeyPress?(KeyPress $== Ctrl+8)(cmd="opentab SettingsPanel")
//*************************************************************
PROGRAM ProgramWindow

ProgramWindow %(cmd)

END PROGRAM

//*************************************************************
// Mute
// Events: onKeyPress?(KeyPress $== F6)
//*************************************************************
PROGRAM Mute

Print Mute
Say "", Priority=HighClear

END PROGRAM

